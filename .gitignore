node_modules/
screenshots/
dist/
.DS_Store

# Secrets / environment — never commit. Keep .env.example as the template.
.env
.env.*
!.env.example

# Local tooling state
.netlify
.codex/

# Source images dropped in for an agent to work from — originals of logos,
# favicons and photos, not the site's own /uploads/ (those live on the VPS and
# are served from there). Working material, and heavy: it is easy to commit
# most of a megabyte of PNGs here by accident.
uploads/

# Local Wallapop preparation records (device-only working data)
local-data/

# Google service account keys — never commit (private credentials)
*-service_account.json
*.iam.gserviceaccount.com.json
winter-bridge-*.json
service_account*.json

# DB dumps / audit reports — never commit (may contain data, are dev-only artifacts)
products_backup_*.sql
*-audit/

# Google Ads OAuth client + refresh token — never commit (private credentials)
secrets/

# сырые выгрузки Search Console
gsc-inspection*.json
