{
  "name": "site_hs",
  "version": "1.0.0",
  "description": "Mirage Muebles — modern minimalist furniture store (ES/EN)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "vite",
    "wallapop": "vite --host 127.0.0.1 --open /wallapop",
    "build": "vite build",
    "build:seo": "vite build --config vite.config.vps.js && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs && npm run test:hydration",
    "preview": "vite preview --port 3000",
    "shot": "node screenshot.mjs",
    "shot:admin": "node scripts/shot-admin.mjs",
    "catalog:pull": "node scripts/pull-catalog.mjs",
    "settings:pull": "node scripts/pull-settings.mjs",
    "data:pull": "npm run catalog:pull && npm run settings:pull",
    "deploy:dist": "node scripts/deploy-dist.mjs",
    "audit:security": "npm audit --audit-level=low && npm audit --prefix server --omit=dev --audit-level=high",
    "verify": "npm run lint && npm test",
    "deploy:seo": "npm run audit:security && npm run verify && npm run data:pull && npm run build:seo && npm run deploy:dist",
    "test": "vitest run",
    "test:hydration": "node scripts/hydration-head-check.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "gsap": "^3.12.5",
    "jszip": "^3.10.1",
    "lenis": "^1.1.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.4",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  }
}
